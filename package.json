{
  "name": "alomari-associates-redesign",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:goals": "pnpm build:goals && node goal-tracker/server.mjs",
    "build:goals": "vite build --config goal-tracker/vite.config.js",
    "test:goals": "node --test goal-tracker/*.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && pnpm run build:mapit && pnpm run build:congen && pnpm run build:goals",
    "build:congen": "vite build --config congen/vite.config.js",
    "dev:congen": "vite --config congen/vite.config.js",
    "dev:congen-api": "node server/congen-dev.js",
    "test:congen": "node --test congen/*.test.js",
    "build:mapit": "vite build --config mapit/vite.config.ts",
    "dev:mapit": "vite --config mapit/vite.config.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vercel/blob": "2.7.0",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.1",
    "tailwindcss": "4.2.1"
  }
}
